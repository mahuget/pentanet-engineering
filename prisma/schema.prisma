// Pentanet Engineering PLC — Prisma Schema
// Database:  PostgreSQL via Supabase
// ORM:       Prisma 5
// Migration: npx prisma migrate dev  (development)
//            npx prisma migrate deploy (production CI)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Contact form submissions ────────────────────────────────
model ContactSubmission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(200)
  email       String   @db.VarChar(320)
  phone       String?  @db.VarChar(50)
  subject     String   @db.VarChar(300)
  message     String

  // 'new' | 'reviewed' | 'responded' | 'archived'
  status      String   @default("new") @db.VarChar(50)

  // SHA-256 hash of visitor IP — raw IP is never stored
  ipHash      String?  @db.VarChar(64)

  submittedAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
  @@map("contact_submissions")
}

// ─── Quote / project enquiry requests ───────────────────────
model QuoteRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(200)
  company         String?  @db.VarChar(300)
  email           String   @db.VarChar(320)
  phone           String?  @db.VarChar(50)
  projectType     String   @db.VarChar(200)
  projectLocation String?  @db.VarChar(300)
  budgetRange     String?  @db.VarChar(100)
  timeline        String?  @db.VarChar(100)
  description     String

  // Array of selected service slugs
  services        String[]

  // 'new' | 'under_review' | 'quoted' | 'closed'
  status          String   @default("new") @db.VarChar(50)

  // SHA-256 hash of visitor IP — raw IP is never stored
  ipHash          String?  @db.VarChar(64)

  submittedAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
  @@map("quote_requests")
}
