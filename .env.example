# ============================================================
# Pentanet Engineering PLC — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file to .env.local
#   2. Fill in real values from each service's dashboard
#   3. NEVER commit .env.local — it is in .gitignore
#   4. For Vercel production: add these in Project → Settings → Environment Variables
# ============================================================

# ── App ──────────────────────────────────────────────────────
# Full URL of the site (no trailing slash)
# Development: http://localhost:3000
# Production:  https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: Supabase PostgreSQL ────────────────────────────
# Get from: supabase.com → your project → Settings → Database → Connection string
#
# DATABASE_URL: Use the POOLER (PgBouncer) connection for the app runtime
#   Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL: Use the DIRECT connection for Prisma migrations only
#   Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Without these set, the contact/quote forms skip database persistence gracefully.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Sanity CMS ────────────────────────────────────────────────
# Get from: sanity.io → your project → API
#
# NEXT_PUBLIC_ prefix is intentional — project ID and dataset are not secrets.
# SANITY_API_TOKEN: Create a "Viewer" (read-only) token in Sanity API settings.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-read-only-viewer-token

# ── Email: Resend ─────────────────────────────────────────────
# Get from: resend.com → API Keys → Create API Key
#
# RESEND_FROM_ADDRESS: The verified "From" address (must be verified in Resend)
# RESEND_NOTIFY_ADDRESS: Where to send notification emails (your inbox)
#
# Without these set, email notifications are skipped gracefully.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_ADDRESS=noreply@pentanet.com
RESEND_NOTIFY_ADDRESS=info@pentanet.com

# ── Spam Protection: Cloudflare Turnstile ─────────────────────
# Get from: dash.cloudflare.com → Turnstile → Add site
#
# NEXT_PUBLIC_ prefix is intentional — site key is embedded in the browser widget.
# TURNSTILE_SECRET_KEY is server-only — never prefix with NEXT_PUBLIC_.
#
# Without these set, Turnstile verification is bypassed in development only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Rate Limiting: Upstash Redis (optional) ───────────────────
# Get from: upstash.com → Create Redis database → REST API tab
#
# Without these, an in-memory rate limiter is used (resets on cold start).
# For production, Upstash is strongly recommended.
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
